# ============================================================================
# Local dev quick start
#   1. cp .env.example .env  and set POSTGRES_* + a stable SECRET_KEY.
#   2. (optional) set GEMINI_KEYS to enable real chat answers + table extraction.
#      GEMINI_KEYS is used by BOTH the API (chat answer generation) and the
#      worker (PDF table extraction); leave empty to run without Gemini.
#   3. docker compose --env-file .env up --build
#      → brings up db + migrate + backend (:8000) + worker.
#   4. Frontend: set VITE_API_URL=http://localhost:8000/api (see frontend/.env.example)
#      and run the dev server; it proxies /api to :8000.
# ============================================================================

# ---- API ----
PROJECT_NAME=Document Management System
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# ---- Security ----
# REQUIRED: set an explicit, stable secret. The server refuses to start without
# it (a random per-restart key would invalidate all tokens on every boot).
SECRET_KEY=please_change_this_to_a_random_secure_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
# Either set DATABASE_URL directly, or provide the POSTGRES_* parts (the app
# assembles the URL the same way the Python settings did).
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/your_database_name

# ---- CORS ----
# Comma-separated or JSON-array form both accepted.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Uploads ----
# Max upload size in MB, enforced on POST /api/upload via io.LimitReader.
MAX_UPLOAD_SIZE=50

# ---- Storage ----
# STORAGE_TYPE selects the backend: "local" (filesystem) or "s3".
STORAGE_TYPE=local
# Root directory for local storage (created if missing).
LOCAL_STORAGE_PATH=./uploads
# S3 settings (only used when STORAGE_TYPE=s3). If access key/secret are left
# blank, the default AWS credential chain (env, shared config, IAM role) is used.
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Worker (document processing) ----
# Max jobs processed concurrently by one worker process.
MAX_CONCURRENT_JOBS=2
# How often the worker polls the queue for new jobs (milliseconds).
JOB_POLL_INTERVAL_MS=1000
# A job whose lock is older than this is reclaimed (worker presumed dead).
# Raised to 120 in Phase 3 to accommodate long PDF extraction jobs.
JOB_LOCK_TIMEOUT_MINUTES=120
# Identifier recorded on claimed jobs; defaults to the hostname if unset.
# WORKER_ID=worker-1

# ---- Extraction (Phase 3) ----
# Space-separated Gemini API keys for table extraction (key rotation).
# Leave empty to skip table extraction; text extraction still runs.
GEMINI_KEYS=
# tesseract language(s) for OCR of scanned pages (e.g. "eng" or "eng+hin").
# OCR is skipped gracefully if the tesseract binary is not installed.
OCR_LANGUAGE=eng
# Bounded page concurrency for Gemini/OCR work within one document.
MAX_PAGE_WORKERS=4

# ---- Indexing + chat (Phase 4) ----
# RAG chunking: chunk size and overlap (characters) used by the indexer.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Gemini model used for chat answers (reuses GEMINI_KEYS). If GEMINI_KEYS is
# empty, chat falls back to a template response.
CHAT_MODEL=gemini-2.0-flash

# ---- Tests ----
# Integration tests (go test -tags=integration ./test/integration/...) only need
# a reachable database — they apply the Go migrations themselves via
# repository.Migrate (no alembic / manual schema step required).
# TEST_DATABASE_URL=postgres://your_postgres_user:your_postgres_password@localhost:5432/your_database_name
