# Application settings
PROJECT_NAME=Document Management System

# Security settings
SECRET_KEY=please_change_this_to_a_random_secure_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# File storage settings
STORAGE_TYPE=s3  # Options: local, s3
LOCAL_STORAGE_PATH=./uploads  # Path for local file storage (fallback)
MAX_UPLOAD_SIZE=50  # Max upload size in MB

# S3 Settings
S3_BUCKET_NAME=your_bucket_name
S3_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# CORS settings
BACKEND_CORS_ORIGINS=["https://yourdomain.com","http://localhost:3000"]

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Security headers
SECURITY_HEADERS=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax  # Options: Lax, Strict, None